# Toast

# # Production
# CLIENT_ID=""
# CLIENT_SECRET=""

# TOAST_URL="https://toastapp.dev"

# localhost
CLIENT_ID="toast-app-client"
CLIENT_SECRET="toast-app-secret"

TOAST_URL="http://localhost:3030"

NODE_ENV="development"

# 토큰 만료 시간(초) 설정
# 서버 expires_in이 우선합니다. 아래 값은 서버가 만료 시간을 보내지 않을 때만 사용합니다.
# - 2592000 은 30일입니다.
# - 0은 즉시 만료, -1은 로컬 만료 검사를 비활성화합니다. 서버 만료·폐기는 그대로 적용됩니다.
TOKEN_EXPIRES_IN="2592000"

# 무제한 토큰으로 설정하려면 아래 줄의 주석을 제거하세요
# TOKEN_EXPIRES_IN="-1"
